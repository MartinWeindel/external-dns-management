#############      builder       #############
FROM golang:1.26.4 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN GOARCH=amd64 GOOS=linux make release-fips

############# base
# distroless/static is used intentionally over gardenlinux-fips:
# The Go binary enforces FIPS 140-3 entirely through its baked-in GOFIPS140
# module — it is a static binary that never calls into the system's OpenSSL or
# any other native crypto library. gardenlinux-fips would add ~70 MB of
# OS user-space (glibc, OpenSSL FIPS provider, apt, …) that the binary does not
# use, increasing image size and attack surface with no functional benefit.
# Use gardenlinux-fips as the base only if a compliance regime explicitly
# requires the surrounding container OS to be on a FIPS-validated image (not
# just the application binary).
FROM gcr.io/distroless/static-debian13:nonroot AS base

#############      dns-controller-manager     #############
FROM base AS dns-controller-manager
WORKDIR /

COPY --from=builder /build/dns-controller-manager /dns-controller-manager

USER nobody

ENTRYPOINT ["/dns-controller-manager"]

#############      dns-controller-manager-next-generation     #############
FROM base AS dns-controller-manager-next-generation
WORKDIR /

COPY --from=builder /build/dns-controller-manager-next-generation /dns-controller-manager-next-generation

USER nobody

ENTRYPOINT ["/dns-controller-manager-next-generation"]
