#############      builder       #############
FROM golang:1.26.4 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN make release-fips

############# base
# gardenlinux-fips provides a FIPS 140-3 validated user-space (OpenSSL FIPS provider
# enabled system-wide). The Go binary already enforces FIPS via its baked-in
# GOFIPS140 module (DefaultGODEBUG=fips140=on); this base image satisfies any
# external audit requirement for the surrounding container environment.
FROM ghcr.io/gardenlinux/gardenlinux-fips:1877.19 AS base
# nobody:nogroup (65534:65534) is present in all Debian-derived images including gardenlinux.

#############      dns-controller-manager     #############
FROM base AS dns-controller-manager
WORKDIR /

COPY --from=builder /build/dns-controller-manager /dns-controller-manager

USER nobody

ENTRYPOINT ["/dns-controller-manager"]

#############      dns-controller-manager-next-generation     #############
FROM base AS dns-controller-manager-next-generation
WORKDIR /

COPY --from=builder /build/dns-controller-manager-next-generation /dns-controller-manager-next-generation

USER nobody

ENTRYPOINT ["/dns-controller-manager-next-generation"]
